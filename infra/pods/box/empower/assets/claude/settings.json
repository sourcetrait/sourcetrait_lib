{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "skipDangerousModePermissionPrompt": true,
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/sourcetrait/empower/no.bash"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /usr/local/bin/sourcetrait/empower/statusline.bash"
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "theme": "dark",
  "effortLevel": "xhigh",
  "model": "opus[1m]"
}