ARG BASE="ghcr.io/sourcetrait/box:latest"
FROM ${BASE} 
LABEL name="sourcetrait/box/empower" version="0.0.1"

USER root
ENV HOME=/root
WORKDIR /tmp

ENV CLAUDE_CONFIG_DIR="$HOME/.sys/.claude"

# install empower package via copr
RUN dnf -y copr enable sourcetrait/ai 
RUN dnf -y update

# install claude-code via npm
npm install -g @anthropic-ai/claude-code

RUN dnf -y install sourcetrait_ai_empower

USER box 
ENV HOME=/home/box
WORKDIR /tmp

# install claude env autoload

# copy claude assets from empower
RUN << EOF
set -eu
mkdir -p /home/box/.config/nushell/once
mkdir -p /home/box/.sys/.claude
cp /usr/local/share/sourcetrait/empower/claude/nu/claude.config.nu /home/box/.config/nushell/autoload/
ln /usr/local/share/sourcetrait/empower/claude/nu/claude.once.nu /home/box/.config/nushell/once/claude.once.nu
cp /usr/local/share/sourcetrait/empower/claude/settings.json /home/box/sys/.claude/ 
cp /usr/local/share/sourcetrait/empower/claude/CLAUDE.md /home/box/sys/.claude/ 
EOF

USER root
ENV HOME=/root
WORKDIR /root

# wipe /tmp, santize access for /root and /home/box
RUN << EOF
set -eu
rm -rf /tmp/*
rm -rf /tmp/.*
chown -R box:box /home/box
chmod -R go-rwx /home/box 
chown -R root:root /root
chmod -R go-rwx /root 
EOF
