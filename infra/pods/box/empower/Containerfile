ARG BASE="localhost/sourcetrait/box:latest"
FROM ${BASE} 
LABEL name="sourcetrait/box/empower" version="0.0.1"

USER root
ENV HOME=/root
WORKDIR /tmp

npm install -g @anthropic-ai/claude-code
# copy assets
RUN mkdir -p /usr/local/share/box/ai/claude
COPY --chmod=644 assets/claude/settings.json /usr/local/share/box/features/claude/
COPY --chmod=644 assets/claude/CLAUDE.md /usr/local/share/box/features/claude/
COPY --chmod-644 assets/claude/statusline.bash /usr/local/share/box/features/claude/

WORKDIR /root

