FROM registry.fedoraproject.org/fedora-toolbox:latest
LABEL name="sourcetrait/box" version="0.0.6"

USER root
ENV HOME=/root
WORKDIR /tmp

# xdg cache, data, state live in dirs within `~/.sys/.xdg`
ENV XDG_CACHE_HOME="$HOME/.sys/.xdg/cache"
ENV XDG_DATA_HOME="$HOME/.sys/.xdg/data"
ENV XDG_STATE_HOME="$HOME/.sys/.xdg/state"
ENV XDGX_PRIVATE_HOME="$HOME/.sys/.xdg/private"

RUN mkdir -p $HOME/.sys/.xdg/{cache,data,state} $HOME/.sys/.xdg/private/{cache,data,state}

RUN dnf -y upgrade

# install custom dnf repositories
COPY --chmod=0640 assets/repos/gemfury-nushell.repo /etc/yum.repos.d/
COPY --chmod=0640 assets/repos/charm-glow.repo /etc/yum.repos.d/
RUN dnf -y copr enable lihaohong/yazi

# install dnf packages
RUN dnf -y install nushell helix openssh-server openssl-devel nodejs24 npm \
  glow ripgrep python3-lxml tokei fd-find tree-sitter-cli libtree-sitter-rust \
  jq git-lfs yazi

# required for ssh to work
RUN chmod 640 /etc/shadow

# add user with sudo
RUN useradd -m -k /dev/null -s /usr/bin/nu box
RUN echo "box:box" | chpasswd
COPY --chmod=440 assets/etc/sudoers.d/box /etc/sudoers.d/ 

# copy the two possible entrypoints: ssh (normal) and shell (debug)
COPY --chmod=750 assets/entrypoint.sshd.sh /usr/local/bin/sourcetrait/box/
COPY --chmod=750 assets/entrypoint.nushell.sh /usr/local/bin/sourcetrait/box/

# basic ENV setup at SSH login
COPY --chmod=644 assets/etc/security/pam_env.conf /etc/security/

# = BEGIN USER box =
USER box
ENV HOME=/home/box
WORKDIR /home/box

RUN mkdir -p $HOME/.sys/.xdg/{cache,data,state} $HOME/.sys/.xdg/private/{cache,data,state}

# our user directories take their own approach
# many of the top-level ones have their own README.md
RUN mkdir ai back data file info mix net proj repo sync .sys tmp xtra
RUN mkdir -p mix/{image,video,audio,screen,scan}
RUN mkdir -p tmp/down
RUN mkdir -p .sys/app/{bin,lib,share}
RUN mkdir -p .sys/local/{bin,lib,etc,share,src}

# copy xdg user dirs settings
COPY assets/config/user-dirs.dirs .config/ 

# setup rustup's env
ENV RUSTUP_HOME="$HOME/.sys/.rustup"
# setup cargo's env
ENV CARGO_HOME="$HOME/.sys/.cargo"
ENV PATH="${PATH}:$HOME/.sys/.cargo/bin"

# initialize nu in home. setup the autoload dir
RUN nu -l -c banner
RUN mkdir -p .config/nushell/autoload

# install and setup rust as a user-maintained tool
RUN --mount=type=cache,target=/home/box/.sys/.cargo/registry \
    --mount=type=cache,target=/home/box/.sys/.cargo/git << EOF
set -eu
curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --no-modify-path --profile minimal --default-toolchain stable \
        -c rust-src -c rust-analyzer
rustup toolchain add nightly
cargo install --locked cargo-cache
cargo install --locked ast-grep
EOF

RUN mkdir -p $CARGO_HOME/{registry,git}

# copy user directory readme files to their locations
COPY assets/docs/WELCOME.md ./
COPY assets/docs/README.ai.md ai/README.md
COPY assets/docs/README.back.md back/README.md
COPY assets/docs/README.data.md data/README.md
COPY assets/docs/README.file.md file/README.md
COPY assets/docs/README.info.md info/README.md
COPY assets/docs/README.mix.md mix/README.md
COPY assets/docs/README.net.md net/README.md
COPY assets/docs/README.proj.md proj/README.md
COPY assets/docs/README.repo.md repo/README.md
COPY assets/docs/README.sync.md sync/README.md
COPY assets/docs/README.sys.md .sys/README.md
COPY assets/docs/README.xtra.md xtra/README.md

# copy any sub-directory documents
COPY assets/docs/info/ENVIRONMENT.info.md info/ENVIRONMENT.md
COPY assets/docs/.sys/README.app.md .sys/app/README.md
COPY assets/docs/.sys/README.local.md .sys/local/README.md

# copy nushell environment scripts
COPY assets/nu/login.nu .config/nushell/
COPY assets/nu/banner.nu .config/nushell/
COPY assets/nu/config.nu .config/nushell/

# configure glow: run it once to setup its `.config`, then edit the style
RUN glow --version
RUN sed -i'' 's/style: "auto"/style: "tokyo-night"/g' .config/glow/glow.yml

# = BEGIN USER ROOT =
USER root
ENV HOME=/root
WORKDIR /tmp

RUN mkdir -p /usr/local/{share/sourcetrait/box,bin/sourcetrait/box,etc/sourcetrait/box}

# copy boxing administrative tool 
COPY --chmod=755 assets/bin/boxing.nu /usr/local/bin/sourcetrait/box
RUN ln -s /usr/local/bin/sourcetrait/box/boxing.nu /usr/local/bin/boxing

WORKDIR /root

# wipe /tmp, santize access for /root and /home/box
RUN << EOF
set -eu
rm -rf /tmp/*
rm -rf /tmp/.*
chown -R box:box /home/box
chmod -R go-rwx /home/box 
chown -R root:root /root
chmod -R go-rwx /root 
EOF

# === SYSTEM IS READY ===

# run as root: one of the entry points
ENTRYPOINT ["/usr/local/bin/sourcetrait/box/entrypoint.sshd.sh"]

# debugging
#ENTRYPOINT ["/usr/local/bin/entrypoint.nushell.sh"]
