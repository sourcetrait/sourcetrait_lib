FROM registry.fedoraproject.org/fedora-toolbox:latest
LABEL name="sourcetrait/box" version="0.0.6"
ARG box_features

USER root
WORKDIR /tmp/init

RUN dnf -y upgrade

# install custom dnf repositories
COPY --chmod=0640 assets/repos/gemfury-nushell.repo /etc/yum.repos.d/
COPY --chmod=0640 assets/repos/charm-glow.repo /etc/yum.repos.d/
dnf -y copr enable lihaohong/yazi

# install dnf packages
RUN dnf -y install nushell helix openssh-server openssl-devel nodejs24 npm \
  glow ripgrep python3-lxml tokei fd-find tree-sitter-cli libtree-sitter-rust \
  jq git-lfs yazi

# required for ssh to work
RUN chmod 640 /etc/shadow

# add user with sudo
RUN useradd -m -k /dev/null -s /usr/bin/nu box
RUN echo "box:box" | chpasswd
COPY --chmod=440 assets/etc/sudoers.d/box /etc/sudoers.d/ 

# copy the two possible entrypoints: ssh (normal) and shell (debug)
COPY --chmod=750 assets/entrypoint.sshd.sh /usr/local/bin/
COPY --chmod=755 assets/entrypoint.nushell.sh /usr/local/bin/

# = BEGIN USER box =
USER box
WORKDIR /home/box

# our user directories take their own approach
# many of the top-level ones have their own README.md
RUN mkdir ai app data info local misc proj repos sys tmp
RUN mkdir -p app/{bin,lib,share}
RUN mkdir -p local/{bin,lib,etc,share,src}
RUN mkdir -p sys/.xdg/{cache,data,state}

# xdg cache, data, state live in dirs within `~/.sys/.xdg`
ENV XDG_CACHE_HOME "sys/.xdg/cache"
ENV XDG_DATA_HOME "sys/.xdg/data"
ENV XDG_STATE_HOME "sys/.xdg/state"

# copy xdg user dirs settings
COPY --chown=box assets/config/user-dirs.dirs ~/.config/ 

# setup rustup's env
ENV RUSTUP_HOME "sys/.rustup"
# setup cargo's env
ENV CARGO_HOME "sys/.cargo"

# initialize nu in home
RUN nu -l -c banner

# install rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="${PATH}:/home/box/sys/.cargo/bin"
RUN rm .profile

RUN rustup toolchain add nightly
RUN rustup component add rust-src
RUN rustup component add rust-analyzer
RUN cargo install --locked cargo-cache
RUN cargo install --locked ast-grep
RUN cargo-cache -e

# copy user directory readme files to their locations
COPY --chown=box assets/docs/WELCOME.md ./
COPY --chown=box assets/docs/README.app.md app/README.md
COPY --chown=box assets/docs/README.ai.md ai/README.md
COPY --chown=box assets/docs/README.data.md data/README.md
COPY --chown=box assets/docs/README.info.md info/README.md
COPY --chown=box assets/docs/README.local.md local/README.md
COPY --chown=box assets/docs/README.misc.md misc/README.md
COPY --chown=box assets/docs/README.proj.md proj/README.md
COPY --chown=box assets/docs/README.repos.md repos/README.md
COPY --chown=box assets/docs/README.sys.md sys/README.md

# copy any sub-directory documents
COPY --chown=box assets/docs/info/ENVIRONMENT.info.md info/ENVIRONMENT.md

# copy nushell environment scripts
COPY --chown=box assets/nu/login.nu .config/nushell/
COPY --chown=box assets/nu/banner.nu .config/nushell/
COPY --chown=box assets/nu/config.nu .config/nushell/

# configure glow: run it once to setup its `.config`, then edit the style
RUN glow --version
RUN sed -i'' 's/style: "auto"/style: "tokyo-night"/g' .config/glow/glow.yml

# = BEGIN USER ROOT =
USER root
WORKDIR=/tmp/init
RUN mkdir -p /tmp/init/user/claude

# copy optional user assets for use by feature scripts
COPY --chown=box assets/claude/settings.json /tmp/init/user/claude/
COPY --chown=box assets/claude/CLAUDE.md /tmp/init/user/claude/
COPY --chown=box assets/claude/statusline.bash /tmp/init/user/claude/

# copy features scripts
COPY --chown=root assets/features_root.nu /tmp/init/
COPY --chown=root assets/features_user.nu /tmp/init/

# run feature setup as root
RUN nu /tmp/init/features_root.nu ${box_features}

# = BEGIN USER BOX =
USER box 
WORKDIR /home/box

# run feature setup as user
RUN nu /tmp/init/features_user.nu ${box_features}

# = BEGIN USER ROOT =
USER root
WORKDIR /root

# wipe the tmp directory 
RUN rm -rf /tmp/*
RUN rm -rf /tmp/.*

# sanitize user home ownership and permissions
RUN chown -R box:box /home/box
RUN chmod -R go-rwx /home/box 

# sanitize root home ownership and permissions
RUN chown -R root:root /root
RUN chmod -R go-rwx /root 

# === SYSTEM IS READY ===

# run as root: one of the entry points
ENTRYPOINT ["/usr/local/bin/entrypoint.sshd.sh"]

# debugging
#ENTRYPOINT ["/usr/local/bin/entrypoint.nushell.sh"]
