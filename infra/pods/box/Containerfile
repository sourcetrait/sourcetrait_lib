FROM registry.fedoraproject.org/fedora-toolbox:latest
LABEL name="sourcetrait/box" version="0.0.1"
RUN dnf -y upgrade
RUN dnf -y install gocryptfs
# rootless escalation fails with pam otherwise (sudo)
RUN sed -i 's/account    include      system-auth/account    sufficient   pam_permit.so/' /etc/pam.d/sudo
RUN sed -i 's|auth       include      system-auth|auth       required     pam_exec.so expose_authtok /usr/local/bin/check_password.sh|' /etc/pam.d/sudo
# install nushell
COPY --chmod=0644 assets/nushell.repo /etc/yum.repos.d/
RUN dnf -y install nushell
# add user with sudo (no passwd)
RUN useradd -m -k /dev/null -s /usr/bin/nu box
RUN echo "box ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/box
RUN chmod 0440 /etc/sudoers.d/box
USER box
WORKDIR /home/box
RUN mkdir -p app/bin app/lib app/src app/var data misc text sys/doc tmp
COPY assets/README.box.md sys/doc
# run the user.nu init script
RUN nu -l -c banner
COPY assets/login.nu .config/nushell/
COPY assets/box.banner .config/nushell/
RUN mkdir /tmp/init
COPY assets/config.nu /tmp/init/
RUN cat /tmp/init/config.nu >> .config/nushell/config.nu
RUN rm -rf /tmp/init
ENTRYPOINT ["/usr/bin/nu", "-l"]
